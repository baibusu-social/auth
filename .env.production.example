# Production environment variables for auth-forwarder
# Copy this to .env.production and update with your actual values

# Server configuration
PORT=3000
NODE_ENV=production

# Base URL for your application (CHANGE THIS)
BASE_URL=https://auth.yourdomain.com

# Session configuration (GENERATE A NEW SECRET)
SESSION_SECRET=your-production-session-secret-should-be-very-long-and-random

# Logto configuration (UPDATE THESE)
LOGTO_ENDPOINT=https://your-logto-endpoint
LOGTO_APP_ID=your-logto-app-id
LOGTO_APP_SECRET=your-logto-app-secret

# Optional: Resources and scopes (comma-separated)
# LOGTO_RESOURCES=  # Leave empty for basic auth forwarding
LOGTO_SCOPES=openid,profile,email

# Discord configuration for guild membership verification (UPDATE THESE)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_GUILD_ID=your-discord-guild-id
DISCORD_REDIRECT_URI=https://auth.yourdomain.com/discord/callback
