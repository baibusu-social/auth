# Environment variables for auth-forwarder

# Server configuration
PORT=3000
NODE_ENV=development

# Base URL for your application
# For local development: http://localhost:3000
# For Docker/Production: https://your-domain.com or http://your-server:port
BASE_URL=http://localhost:3000

# Session configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Redis configuration (optional - for session persistence)
# REDIS_URL=redis://localhost:6379

# Logto configuration
LOGTO_ENDPOINT=https://your-logto-endpoint
LOGTO_APP_ID=your-logto-app-id
LOGTO_APP_SECRET=your-logto-app-secret

# Optional: Resources and scopes (comma-separated)
# LOGTO_RESOURCES=  # Leave empty for basic auth forwarding
LOGTO_SCOPES=openid,profile,email

# Discord configuration for guild membership verification
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_GUILD_ID=your-discord-guild-id
# For local development: http://localhost:3000/discord/callback
# For Docker/Production: https://your-domain.com/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/discord/callback
